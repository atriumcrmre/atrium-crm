{
  "name": "atrium-crm",
  "version": "1.0.0",
  "description": "Atrium real-estate CRM: Node.js API, PostgreSQL, Google/Microsoft mail and calendar sync, SendGrid marketing email, Netlify landing pages, Zillow, CoStar and DocuSign integrations, Keystone AI.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "gen:keys": "node scripts/gen-keys.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:providers": "node scripts/provider-test.js",
    "dev:db": "node scripts/dev-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.5.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^17.2.0-beta.15"
  }
}
